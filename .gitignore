# ---------------------------------------------------------------------------
# Kali Lab — .gitignore
# Local, machine-specific or regenerated artifacts. Anything here is rebuilt by
# `make venv` / `make bake` / `make deploy` and must NEVER be committed (a venv
# in particular is not relocatable across machines/paths).
# ---------------------------------------------------------------------------

# Python virtualenv (Ansible) — regenerated by `make venv`
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Locally-installed tool binaries (Terraform auto-install)
.bin/

# Packer build artifacts
build/output-kali/
build/manifest.json
build/packer_cache/
build/iso.auto.pkrvars.hcl
*.auto.pkrvars.hcl

# Provenance manifests + app-list backups (regenerated per build/VM)
build/manifests/*.json
build/apps/*.selections
build/apps/*.manual

# Terraform state, lock and local config
deploy/.terraform/
deploy/.terraform.lock.hcl
deploy/terraform.tfstate
deploy/terraform.tfstate.backup
deploy/terraform.tfstate.d/
deploy/terraform.tfvars
crash.log
crash.*.log

# Disk images (goldens, overlays, data disks, exports)
*.qcow2
*.raw
*.img

# Default virtiofs shared folder (host<->guest exchange)
shared/

# Exported images (split/encrypted copies)
export/

# Local Make config (per-host overrides)
.env

# Secrets — never commit VPN profiles, keys or auth stores
*.ovpn
*.pem
*.key
*.p12
*.pfx
id_ed25519*
id_rsa*
auth.json
# local OpenCode config carrying secrets (the tracked template lives in
# provision/files/opencode.json and must stay secret-free)
**/opencode.local.json

# Ansible
*.retry

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
