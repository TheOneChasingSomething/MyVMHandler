index 0000000..0f80dbf
--- /dev/null
+++ b/kali-lab/provision/files/lab-services.py
@@ -0,0 +1,264 @@
+#!/usr/bin/env python3
+"""Live Docker / listening-service inventory; Python standard library only."""
+
+import argparse
+import curses
+from datetime import datetime
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import socket
+import subprocess
+import sys
+import textwrap
+import time
+
+
+def clean(value):
+    return " ".join("".join(c for c in str(value) if c.isprintable()).split())
+
+
+def run(command):
+    try:
+        result = subprocess.run(
+            command, stdin=subprocess.DEVNULL, capture_output=True, text=True,
+            errors="replace", timeout=4, env={**os.environ, "LC_ALL": "C"},
+        )
+    except (OSError, subprocess.TimeoutExpired) as error:
+        return None, clean(error)
+    if result.returncode:
+        return None, clean(result.stderr or result.stdout or "command failed")
+    return result.stdout, None
+
+
+def read_sockets():
+    # Best effort only: never ask for a password or change sudo permissions.
+    if os.geteuid() != 0 and shutil.which("sudo"):
+        output, error = run(["sudo", "-n", "ss", "-H", "-lntup"])
+        if error is None:
+            return output, None
+    return run(["ss", "-H", "-lntup"])
+
+
+def process_name(name, command):
+    if not name.startswith(("python", "pypy")):
+        return name
+    try:
+        arguments = shlex.split(command)
+    except ValueError:
+        return name
+    if "-m" in arguments:
+        index = arguments.index("-m") + 1
+        if index < len(arguments):
+            return arguments[index]
+    for argument in arguments[1:]:
+        if argument.endswith(".py"):
+            path = Path(argument)
+            return str(Path(path.parent.name) / path.name)
+    return name
+
+
+def collect():
+    snapshot = {"containers": [], "listeners": [], "failed": [], "errors": []}
+    snapshot["updated"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
+    published = set()
+    if shutil.which("docker"):
+        command = ["docker", "ps", "-a", "--no-trunc", "--format", "{{json .}}"]
+        output, error = run(command)
+        if error and os.geteuid() != 0 and shutil.which("sudo"):
+            output, error = run(["sudo", "-n", *command])
+        if error:
+            snapshot["errors"].append("Docker: " + error)
+        else:
+            try:
+                snapshot["containers"] = sorted(
+                    (json.loads(line) for line in output.splitlines() if line),
+                    key=lambda row: row["Names"],
+                )
+            except (ValueError, KeyError) as error:
+                snapshot["errors"].append("Docker inventory: " + str(error))
+    else:
+        snapshot["errors"].append("Docker is not installed.")
+    for row in snapshot["containers"]:
+        for match in re.finditer(r"([^,\s]+):(\d+)->\d+/(tcp|udp)", row["Ports"]):
+            published.add((match[3], match[1], match[2]))
+
+    output, error = run([
+        "systemctl", "list-units", "--type=service", "--state=running,failed",
+        "--no-legend", "--plain", "--no-pager",
+    ])
+    snapshot["running_units"] = None if error else 0
+    if error:
+        snapshot["errors"].append("systemd: " + error)
+    else:
+        for line in output.splitlines():
+            fields = line.split(None, 4)
+            if len(fields) >= 4:
+                if fields[2] == "failed":
+                    snapshot["failed"].append((fields[0], fields[3]))
+                elif fields[3] == "running":
+                    snapshot["running_units"] += 1
+
+    output, error = read_sockets()
+    if error:
+        snapshot["errors"].append("Listening sockets: " + error)
+        return snapshot
+    listeners = {}
+    for line in output.splitlines():
+        fields = line.split(None, 6)
+        if len(fields) < 6:
+            continue
+        protocol, state, _, _, address, _ = fields[:6]
+        host, port = address.rsplit(":", 1)
+        process = re.search(r'\("([^"]+)",pid=(\d+)', fields[6] if len(fields) > 6 else "")
+        name, pid = process.groups() if process else ("unknown", "")
+        if name == "docker-proxy" or (protocol, host, port) in published:
+            continue
+        key = (pid, name)
+        listener = listeners.setdefault(key, {"ports": set(), "states": set()})
+        listener["ports"].add(f"{protocol} {address}")
+        listener["states"].add("BOUND" if state == "UNCONN" else state)
+    pids = sorted({pid for pid, _ in listeners if pid})
+    commands = {}
+    if pids:
+        output, _ = run(["ps", "-ww", "-p", ",".join(pids), "-o", "pid=,args="])
+        for line in (output or "").splitlines():
+            fields = line.strip().split(None, 1)
+            if len(fields) == 2:
+                commands[fields[0]] = fields[1]
+    for (pid, name), listener in listeners.items():
+        label = process_name(name, commands.get(pid, ""))
+        if pid:
+            label += f" (pid {pid})"
+        snapshot["listeners"].append((
+            label, ", ".join(sorted(listener["ports"])), " / ".join(sorted(listener["states"])),
+        ))
+    snapshot["listeners"].sort()
+    return snapshot
+
+
+def table(headers, rows, width, weights):
+    available = max(len(headers), width - 3 * (len(headers) - 1))
+    widths = [max(1, int(available * weight)) for weight in weights]
+    widths[0] += available - sum(widths)
+    lines = []
+    for index, row in enumerate([headers, *rows]):
+        cells = [textwrap.wrap(clean(cell), size, break_on_hyphens=False) or [""]
+                 for cell, size in zip(row, widths)]
+        for part in range(max(map(len, cells))):
+            lines.append(" | ".join(
+                (cell[part] if part < len(cell) else "").ljust(size)
+                for cell, size in zip(cells, widths)
+            ).rstrip())
+        if index == 0:
+            lines.append("-+-".join("-" * size for size in widths))
+    return lines
+
+
+def render(snapshot, width):
+    containers = snapshot["containers"]
+    running = sum(row.get("State") == "running" for row in containers)
+    healthy = sum("(healthy)" in row.get("Status", "") for row in containers)
+    units = snapshot["running_units"]
+    summary = (
+        f"Docker: {running}/{len(containers)} running, {healthy} healthy | "
+        f"systemd: {units if units is not None else '?'} running, "
+        f"{len(snapshot['failed']) if units is not None else '?'} failed"
+    )
+    lines = [f"KALI SERVICES | {socket.gethostname()} | {snapshot['updated']}"]
+    lines += textwrap.wrap(summary, width)
+    lines += ["", "DOCKER CONTAINERS (host:port -> container port)"]
+    if containers:
+        rows = [(row["Names"], row["Image"], row["Ports"] or "not published", row["Status"])
+                for row in containers]
+        lines += table(("CONTAINER", "IMAGE", "PORTS", "STATUS"), rows, width, (.28, .23, .30, .19))
+        lines += textwrap.wrap("Ports without '->' are internal/exposed only.", width)
+    else:
+        lines.append("No containers found.")
+    lines += ["", "HOST SERVICES (non-Docker listening/bound sockets)"]
+    if snapshot["listeners"]:
+        lines += table(("SERVICE / PROCESS", "PORTS", "STATUS"), snapshot["listeners"],
+                       width, (.35, .50, .15))
+    else:
+        lines.append("No listening services found.")
+    if snapshot["failed"]:
+        lines += ["", "FAILED SYSTEMD SERVICES"]
+        lines += table(("UNIT", "STATUS"), snapshot["failed"], width, (.75, .25))
+    for error in snapshot["errors"]:
+        lines += [""] + textwrap.wrap(clean(error), width)
+    return lines
+
+
+def watch(screen, interval):
+    try:
+        curses.curs_set(0)
+    except curses.error:
+        pass
+    screen.keypad(True)
+    offset, next_refresh = 0, 0
+    while True:
+        if time.monotonic() >= next_refresh:
+            snapshot = collect()
+            next_refresh = time.monotonic() + interval
+        height, width = screen.getmaxyx()
+        body_height = max(1, height - 1)
+        lines = render(snapshot, max(20, width - 1))
+        last_offset = max(0, len(lines) - body_height)
+        offset = min(max(0, offset), last_offset)
+        screen.erase()
+        for y, line in enumerate(lines[offset:offset + body_height]):
+            try:
+                screen.addnstr(y, 0, line, max(0, width - 1))
+            except curses.error:
+                pass
+        footer = f"Up/Down PgUp/PgDn: scroll | r: refresh | q: close | {offset + 1}/{len(lines)}"
+        try:
+            screen.addnstr(height - 1, 0, footer, max(0, width - 1), curses.A_REVERSE)
+        except curses.error:
+            pass
+        screen.refresh()
+        screen.timeout(250)
+        key = screen.getch()
+        if key in (ord("q"), ord("Q")):
+            return
+        if key in (curses.KEY_DOWN, ord("j")):
+            offset += 1
+        elif key in (curses.KEY_UP, ord("k")):
+            offset -= 1
+        elif key == curses.KEY_NPAGE:
+            offset += body_height
+        elif key == curses.KEY_PPAGE:
+            offset -= body_height
+        elif key in (curses.KEY_HOME, ord("g")):
+            offset = 0
+        elif key in (curses.KEY_END, ord("G")):
+            offset = last_offset
+        elif key in (ord("r"), ord("R")):
+            next_refresh = 0
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--watch", type=float, nargs="?", const=5, metavar="SECONDS",
+                        help="refresh interactively (default: 5 seconds)")
+    parser.add_argument("--width", type=int, default=shutil.get_terminal_size((120, 40)).columns,
+                        help="table width for a one-off report")
+    args = parser.parse_args()
+    if args.watch is not None:
+        if args.watch < 1:
+            parser.error("--watch must be at least 1 second")
+        if not sys.stdin.isatty() or not sys.stdout.isatty():
+            parser.error("--watch requires an interactive terminal")
+        try:
+            curses.wrapper(watch, args.watch)
+        except KeyboardInterrupt:
+            pass
+    else:
+        print("\n".join(render(collect(), max(20, args.width))))
+
+
+if __name__ == "__main__":
+    main()
