+---
+- name: Validate SSH dashboard settings
+  ansible.builtin.assert:
+    that:
+      - ssh_dashboard_session_name is match('^[A-Za-z0-9_-]+$')
+      - (ssh_dashboard_refresh_seconds | int) >= 1
+      - (ssh_dashboard_pane_percent | int) >= 20
+      - (ssh_dashboard_pane_percent | int) <= 80
+    fail_msg: "Use a simple tmux session name, a refresh >= 1 s and a pane size of 20–80%."
+
+- name: Find the SSH user's home directory
+  ansible.builtin.getent:
+    database: passwd
+    key: "{{ ansible_user | default('kali') }}"
+
+- name: Create the dashboard support directory
+  ansible.builtin.file:
+    path: /usr/local/share/kali-lab
+    state: directory
+    owner: root
+    group: root
+    mode: "0755"
+
+- name: Install the live services table
+  ansible.builtin.copy:
+    src: lab-services.py
+    dest: /usr/local/bin/lab-services
+    owner: root
+    group: root
+    mode: "0755"
+
+- name: Install the SSH tmux launcher
+  ansible.builtin.template:
+    src: lab-ssh-dashboard.sh.j2
+    dest: /usr/local/bin/lab-ssh-dashboard
+    owner: root
+    group: root
+    mode: "0755"
+    validate: /bin/sh -n %s
+
+- name: Install the interactive SSH shell hook
+  ansible.builtin.copy:
+    src: ssh-dashboard.sh
+    dest: /usr/local/share/kali-lab/ssh-dashboard.sh
+    owner: root
+    group: root
+    mode: "0644"
+    validate: /bin/sh -n %s
+
+- name: Enable the dashboard in Bash and Zsh interactive shells
+  ansible.builtin.blockinfile:
+    path: "{{ ansible_facts.getent_passwd[ansible_user | default('kali')][4] }}/{{ item }}"
+    create: true
+    owner: "{{ ansible_user | default('kali') }}"
+    mode: "0644"
+    marker: "# {mark} KALI LAB SSH DASHBOARD"
+    block: |
+      if [ -r /usr/local/share/kali-lab/ssh-dashboard.sh ]; then
+        . /usr/local/share/kali-lab/ssh-dashboard.sh
+      fi
+  loop:
+    - .bashrc
+    - .zshrc
