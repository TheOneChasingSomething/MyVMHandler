+++ b/kali-lab/provision/files/ssh-dashboard.sh
@@ -0,0 +1,16 @@
+# Sourced from interactive Bash/Zsh rc files. Remote commands, scp, sftp and
+# Ansible do not enter tmux; shells inside an existing tmux do not nest it.
+case $- in
+    *i*)
+        if [ -n "${SSH_CONNECTION:-}" ] &&
+           [ -z "${SSH_ORIGINAL_COMMAND:-}" ] &&
+           [ -z "${TMUX:-}" ] &&
+           [ "${LAB_SSH_DASHBOARD:-1}" != 0 ] &&
+           [ "${TERM:-dumb}" != dumb ] &&
+           [ -t 0 ] && [ -t 1 ] &&
+           [ -x /usr/local/bin/lab-ssh-dashboard ] &&
+           command -v tmux >/dev/null 2>&1; then
+            /usr/local/bin/lab-ssh-dashboard
+        fi
+        ;;
+esac
