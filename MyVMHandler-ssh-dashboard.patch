+++ b/kali-lab/provision/templates/lab-ssh-dashboard.sh.j2
@@ -0,0 +1,37 @@
+#!/bin/sh
+# {{ ansible_managed }}
+# One persistent session per user; a server-side lock prevents duplicate panes
+# when two SSH clients connect at the same time.
+set -eu
+session={{ ssh_dashboard_session_name | quote }}
+lock="kali-lab-dashboard-$session"
+
+if ! tmux has-session -t "=$session" 2>/dev/null; then
+    size=$(stty size 2>/dev/null) || size='24 80'
+    rows=${size%% *}
+    columns=${size##* }
+    tmux new-session -d -s "$session" -n shell -x "$columns" -y "$rows" ||
+        tmux has-session -t "=$session"
+fi
+
+tmux wait-for -L "$lock"
+trap 'tmux wait-for -U "$lock" >/dev/null 2>&1 || true' 0
+trap 'exit 1' HUP INT TERM
+
+case "$(tmux list-panes -s -t "=$session" -F '#{@lab_services_dashboard}')" in
+    *enabled*) ;;
+    *)
+        shell_pane=$(tmux display-message -p -t "=$session" '#{pane_id}')
+        if dashboard_pane=$(tmux split-window -d -v -l '{{ ssh_dashboard_pane_percent | int }}%' \
+            -t "$shell_pane" -P -F '#{pane_id}' \
+            '/usr/local/bin/lab-services --watch {{ ssh_dashboard_refresh_seconds | int }}'); then
+            tmux set-option -p -t "$dashboard_pane" @lab_services_dashboard enabled
+            tmux select-pane -t "$dashboard_pane" -T Services
+            tmux set-option -w -t "$dashboard_pane" pane-border-status top
+        fi
+        ;;
+esac
+
+tmux wait-for -U "$lock"
+trap - 0 HUP INT TERM
+exec tmux attach-session -t "=$session"
