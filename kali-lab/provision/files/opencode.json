{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "@devtheops/opencode-plugin-otel@1.5.1",
      {
        "enabled": true,
        "endpoint": "http://localhost:4317",
        "protocol": "grpc",
        "resourceAttributes": "openinference.project.name=Opencode"
      }
    ]
  ],  
  "provider": {
    "anthropic": {
      "models": {
        "claude-sonnet-4-5": {},
        "claude-opus-4-8": {}
      }
    },
    "openai": {
      "models": {
        "gpt-5": {}
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen2.5-coder:7b": {},
        "llama3.1:8b": {}
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": { "baseURL": "http://localhost:1234/v1" },
      "models": {
        "local-model": {}
      }
    }
  },
  "mcp": {
    "ghidra": {
      "type": "local",
      "command": ["/home/kali/tools/ghidra-mcp/.venv/bin/python", "-m", "bridge_mcp_ghidra"],
      "enabled": true,
      "timeout": 10000
    }
  },
  "model": "openai/gpt-6.1-sol",
  "agent": {
    "build": {
      "model": "openai/gpt-6.1-sol",
      "variant": "max"
    },
    "plan": {
      "model": "openai/gpt-6.1-sol",
      "variant": "max"
    }
  }}
