        {
          "schema_version": 0,
          "attributes": {
            "id": "/var/lib/libvirt/images/poste-cloudinit.iso;af1444a3-42f7-4f5e-b2fb-1c1ae6e5d2e8",
            "meta_data": "",
            "name": "poste-cloudinit.iso",
            "network_config": "version: 2\nethernets:\n  eth0:\n    dhcp4: true\n",
            "pool": "default",
            "user_data": "#cloud-config\nhostname: poste\nmanage_etc_hosts: true\nusers:\n  - name: kali\n    groups: [sudo]\n    shell: /bin/bash\n    lock_passwd: false          # cloud-init locks passwords by default; keep console login working\n    sudo: \"ALL=(ALL) NOPASSWD:ALL\"\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAi+G17YZ2ZIVwggoLiu+1Z46z01RW12XfO8ToVDLw/b me@me\n# Set the console password (SSH still uses the key above). Lab credentials only.\nchpasswd:\n  expire: false\n  users:\n    - name: kali\n      password: kali\n      type: text\nssh_pwauth: true\npackage_update: false\n# Swap file created on first boot (the golden has no swap partition, so root can\n# grow). Runs after resize_rootfs, so the space is already there.\nswap:\n  filename: /swapfile\n  size: 2G\n# One mounts: block only (cloud-init forbids duplicate keys). nofail = boot even\n# if a mount source is missing; /data is mounted by LABEL (device-order-proof).\nmounts:\n  - [ \"hostshare\", /mnt/host, virtiofs, \"defaults,nofail\", \"0\", \"0\" ]\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
