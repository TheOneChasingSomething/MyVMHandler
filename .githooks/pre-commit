#!/usr/bin/env bash
# pre-commit — keep secrets out of Git (OpenVPN configs, private keys, .env files,
# hardcoded API tokens, and references to a .ovpn path). This repo stores such
# things in a per-machine .env (gitignored) and references a variable instead.
#
# Bypass a genuine false positive with:   ALLOW_SECRET=1 git commit ...
set -u

[ "${ALLOW_SECRET:-0}" = "1" ] && exit 0

fail=0
note(){ printf '  \033[31m\xe2\x9c\x97\033[0m %s\n' "$1" >&2; fail=1; }

staged=$(git diff --cached --name-only --diff-filter=ACM)

# 1) Whole files that must never be committed, matched by name / extension.
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    *.ovpn|*.key|*.pem|*.p12|*.pfx|*id_rsa*|*id_ed25519*)
      note "secret-looking file staged: $f" ;;
  esac
  case "$f" in
    .env|*/.env|*.env)
      note "env file staged: $f" ;;
  esac
done <<EOF
$staged
EOF

# 2) Scan ONLY the added lines of the staged diff, as text.
#    -a  : treat input as text  -> no "Binary file matches" noise / false hits
#    --  : end option parsing   -> a pattern starting with '-' is not read as a flag
added=$(git diff --cached -U0 --no-color -- . 2>/dev/null | grep -aE '^\+' | grep -avE '^\+\+\+')

printf '%s\n' "$added" | grep -aEq -- '\.ovpn([^A-Za-z0-9._-]|$)' \
  && note "reference to a .ovpn file/path in a diff"

printf '%s\n' "$added" | grep -aEq -- '-----BEGIN (OPENVPN|RSA|EC|DSA|OPENSSH|PGP|PRIVATE|CERTIFICATE)' \
  && note "private key / OpenVPN / certificate block in a diff"

printf '%s\n' "$added" | grep -aEiq -- '(api[_-]?key|secret|token|passwd|password)[[:space:]]*[:=][[:space:]]*[A-Za-z0-9/_+.=-]{16,}' \
  && note "hardcoded API key / token / password in a diff"

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

[pre-commit] BLOCKED — the staged change looks like it contains a secret.
Keep secrets out of Git: store paths/keys in .env (gitignored) and reference a
variable instead of hardcoding them. If this is a false positive, re-run with:
    ALLOW_SECRET=1 git commit ...
MSG
  exit 1
fi
exit 0
