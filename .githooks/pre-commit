#!/usr/bin/env bash
# kali-lab pre-commit secret guard.
# Blocks committing secret FILES (by name) and secret CONTENT / references
# (by staged diff) — including .ovpn files AND path references to them.
# Bypass a single intentional commit with:  ALLOW_SECRET=1 git commit ...
#
# Activate once (hooks in .githooks/ are inert until Git is pointed at them):
#   git config core.hooksPath .githooks     # (or: make hooks)
set -u

if [ "${ALLOW_SECRET:-0}" = "1" ]; then
  echo "[pre-commit] ALLOW_SECRET=1 — secret guard bypassed for this commit." >&2
  exit 0
fi

fail=0
note() { echo "  ✗ $*" >&2; fail=1; }

# Staged, added/copied/modified files (NUL-safe).
staged() { git diff --cached --name-only --diff-filter=ACM -z; }

# 1) Secret FILES by path/name ------------------------------------------------
while IFS= read -r -d '' f; do
  case "$f" in
    *.ovpn|*.key|*.pem|*.p12|*.pfx|*.kdbx|*.jks) note "secret file staged: $f" ;;
    .env|*/.env|.env.*|*/.env.*) note "env file staged: $f" ;;
    *id_rsa|*id_ed25519|*id_ecdsa|*id_dsa) note "private SSH key staged: $f" ;;
  esac
done < <(staged)

# 2) Secret CONTENT / references in the staged diff (added lines only) --------
# Only added lines (leading '+'), excluding the diff header '+++'.
added="$(git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"

check() { # <regex> <message>
  if printf '%s\n' "$added" | grep -Eiq "$1"; then note "$2"; fi
}

check 'BEGIN [A-Z0-9 ]*PRIVATE KEY'        "private key material in a diff"
check '[A-Za-z0-9_./~ -]*\.ovpn([^A-Za-z0-9]|$)' "reference to a .ovpn file/path in a diff"
check '(AKIA|ASIA)[0-9A-Z]{16}'            "AWS access key id in a diff"
check 'ghp_[0-9A-Za-z]{36}'               "GitHub token in a diff"
check 'xox[baprs]-[0-9A-Za-z-]{10,}'      "Slack token in a diff"
check 'sk-[A-Za-z0-9]{20,}'               "OpenAI-style API key in a diff"
check '-----BEGIN OPENVPN'                 "inline OpenVPN credentials in a diff"
check '(secret|token|api[_-]?key|password)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/_+.-]{12,}' \
                                           "hardcoded secret-looking value in a diff"

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

[pre-commit] BLOCKED — the staged change looks like it contains a secret.
Keep secrets out of Git: store paths/keys in .env (gitignored) and reference a
variable instead of hardcoding them. If this is a false positive, re-run with:
    ALLOW_SECRET=1 git commit ...
MSG
  exit 1
fi
exit 0
